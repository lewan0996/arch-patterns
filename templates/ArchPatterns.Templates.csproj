<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ArchPatterns.Templates</PackageId>
    <PackageVersion>0.2.0</PackageVersion>
    <Authors>ArchPatterns contributors</Authors>
    <Description>Native .NET architecture catalog templates. Microservices solution and flat PostgreSQL direct-service scaffolds.</Description>
    <PackageProjectUrl>https://github.com/lewan0996/arch-patterns</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lewan0996/arch-patterns</RepositoryUrl>
    <PackageType>Template</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dotnet-new;templates;architecture</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content/**/*" Exclude="**/bin/**;**/obj/**" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
